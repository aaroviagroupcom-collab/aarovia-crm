# Production Environment Variables Template
# Copy these to your deployment platform (Render/Vercel)

# Application
NODE_ENV=production
PORT=5000

# Database - From Render PostgreSQL
DATABASE_URL=postgres://username:password@hostname:5432/aarovia_crm

# JWT
JWT_SECRET=your-super-strong-secret-key-minimum-64-characters-change-this
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=https://aarovia-crm.vercel.app

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Aarovia Properties <noreply@aaroviagroup.com>

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Twilio (Voice Calls)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+911234567890

# WhatsApp
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
