# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aarovia:STRONGPASSWORD@postgres:5432/aarovia_crm

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-with-a-very-long-random-secret-min-64-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://aarovia.co.in

# ─── Gmail SMTP ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@aaroviagroup.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Aarovia Properties <noreply@aaroviagroup.com>

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ─── Twilio Voice ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+91xxxxxxxxxx
